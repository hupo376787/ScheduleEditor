<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <HotAvaloniaMode>Balanced</HotAvaloniaMode>
    <HotAvaloniaHotkey>Alt+F5</HotAvaloniaHotkey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentScheduler" Version="6.0.0" />
    <PackageReference Include="NCrontab" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Markup.Xaml.Loader"
                      Version="12.1.0"
                      PrivateAssets="All"
                      Publish="True" />
    <PackageReference Include="HotAvalonia"
                      Version="3.1.4"
                      PrivateAssets="All"
                      Publish="True" />
  </ItemGroup>
</Project>
