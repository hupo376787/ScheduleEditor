<UserControl
    x:Class="ScheduleEditor.Controls.ScheduleEditor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ScheduleEditor.ViewModels"
    x:DataType="vm:ScheduleEditorViewModel"
    MinWidth="560">

  <UserControl.Styles>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ToggleButton.weekday">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style Selector="ToggleButton.weekday:checked">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.action">
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Padding="24"
          BorderBrush="#26000000"
          BorderThickness="1"
          CornerRadius="12">

    <Grid RowDefinitions="Auto,1,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          RowSpacing="18">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock FontSize="20"
                     FontWeight="Bold"
                     Text="{Binding TitleText}" />
          <TextBlock Opacity="0.62"
                     Text="{Binding DescriptionText}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <ToggleSwitch Grid.Column="1"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                      OffContent="{Binding DisabledText}"
                      OnContent="{Binding EnabledText}" />
      </Grid>

      <Border Grid.Row="1" Background="#22000000" Height="1" />

      <Grid Grid.Row="2"
            ColumnDefinitions="110,*"
            ColumnSpacing="18"
            IsEnabled="{Binding IsEnabled}">
        <TextBlock Classes="field-label" Text="{Binding RepeatModeText}" />

        <WrapPanel Grid.Column="1" Orientation="Horizontal">
          <RadioButton Margin="0,0,18,8"
                       GroupName="RepeatType"
                       Content="{Binding EverySecondsText}"
                       IsChecked="{Binding IsEverySeconds, Mode=TwoWay}"
                       IsVisible="{Binding ShowEverySeconds}" />
          <RadioButton Margin="0,0,18,8"
                       GroupName="RepeatType"
                       Content="{Binding EveryMinutesText}"
                       IsChecked="{Binding IsEveryMinutes, Mode=TwoWay}"
                       IsVisible="{Binding ShowEveryMinutes}" />
          <RadioButton Margin="0,0,18,8"
                       GroupName="RepeatType"
                       Content="{Binding EveryHoursText}"
                       IsChecked="{Binding IsEveryHours, Mode=TwoWay}"
                       IsVisible="{Binding ShowEveryHours}" />
          <RadioButton Margin="0,0,18,8"
                       GroupName="RepeatType"
                       Content="{Binding DailyText}"
                       IsChecked="{Binding IsDaily, Mode=TwoWay}"
                       IsVisible="{Binding ShowDaily}" />
          <RadioButton Margin="0,0,18,8"
                       GroupName="RepeatType"
                       Content="{Binding WeeklyText}"
                       IsChecked="{Binding IsWeekly, Mode=TwoWay}"
                       IsVisible="{Binding ShowWeekly}" />
          <RadioButton Margin="0,0,18,8"
                       GroupName="RepeatType"
                       Content="{Binding MonthlyText}"
                       IsChecked="{Binding IsMonthly, Mode=TwoWay}"
                       IsVisible="{Binding ShowMonthly}" />
          <RadioButton Margin="0,0,18,8"
                       GroupName="RepeatType"
                       Content="{Binding CronText}"
                       IsChecked="{Binding IsCron, Mode=TwoWay}"
                       IsVisible="{Binding ShowCron}" />
        </WrapPanel>
      </Grid>

      <Grid Grid.Row="3"
            ColumnDefinitions="110,*"
            ColumnSpacing="18"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsIntervalMode}">
        <TextBlock Classes="field-label" Text="{Binding IntervalText}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <NumericUpDown Width="140"
                         HorizontalAlignment="Left"
                         Increment="1"
                         Minimum="1"
                         Maximum="2147483647"
                         Value="{Binding IntervalValue, Mode=TwoWay}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding IntervalUnitText}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="4"
            ColumnDefinitions="110,*"
            ColumnSpacing="18"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding UsesExecutionTime}">
        <TextBlock Classes="field-label" Text="{Binding ExecutionTimeText}" />
        <TimePicker Grid.Column="1"
                    Width="180"
                    HorizontalAlignment="Left"
                    ClockIdentifier="24HourClock"
                    MinuteIncrement="1"
                    SelectedTime="{Binding ExecuteTime, Mode=TwoWay}"
                    UseSeconds="False" />
      </Grid>

      <Grid Grid.Row="5"
            ColumnDefinitions="110,*"
            ColumnSpacing="18"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsWeekly}">
        <TextBlock Classes="field-label" Text="{Binding WeeklyDaysText}" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekDays}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WeekDayItemViewModel">
              <ToggleButton Classes="weekday"
                            Margin="0,0,8,8"
                            Content="{Binding DisplayName}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            ToolTip.Tip="{Binding FullDisplayName}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <Grid Grid.Row="6"
            ColumnDefinitions="110,*"
            ColumnSpacing="18"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsMonthly}">
        <TextBlock Classes="field-label" Text="{Binding DayOfMonthText}" />
        <StackPanel Grid.Column="1" Spacing="5">
          <NumericUpDown Width="140"
                         HorizontalAlignment="Left"
                         Increment="1"
                         Minimum="1"
                         Maximum="31"
                         Value="{Binding DayOfMonth, Mode=TwoWay}" />
          <TextBlock Opacity="0.62"
                     Text="{Binding MonthlyDayHelpText}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="7"
            ColumnDefinitions="110,*"
            ColumnSpacing="18"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsCron}">
        <TextBlock Classes="field-label"
                   VerticalAlignment="Top"
                   Margin="0,8,0,0"
                   Text="{Binding CronExpressionText}" />
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBox Text="{Binding CronExpression, Mode=TwoWay}"
                   Watermark="0 9 * * *" />
          <TextBlock Opacity="0.62"
                     Text="{Binding CronHelpText}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="8" ColumnDefinitions="110,*" ColumnSpacing="18">
        <TextBlock Classes="field-label" Text="{Binding NextRunLabelText}" />
        <TextBlock Grid.Column="1"
                   FontWeight="SemiBold"
                   Text="{Binding NextRunText}"
                   VerticalAlignment="Center" />
      </Grid>

      <Border Grid.Row="9"
              Padding="14,10"
              Background="#0D0078D4"
              CornerRadius="8">
        <StackPanel Spacing="5">
          <TextBlock FontWeight="SemiBold"
                     Text="{Binding SummaryText}"
                     TextWrapping="Wrap" />
          <TextBlock Foreground="#C62828"
                     IsVisible="{Binding HasError}"
                     Text="{Binding ErrorText}"
                     TextWrapping="Wrap" />
          <TextBlock Foreground="#2E7D32"
                     IsVisible="{Binding HasFeedback}"
                     Text="{Binding FeedbackText}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="10"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal"
                  Spacing="10">
        <Button Classes="action"
                Command="{Binding CancelCommand}"
                Content="{Binding CancelText}" />
        <Button Classes="action accent"
                Command="{Binding SaveCommand}"
                Content="{Binding SaveText}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
