<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep restored packages inside the solution folder so a broken or
         read-only machine-wide NuGet cache cannot block the build. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>

  <packageSources>
    <clear />
    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json"
         protocolVersion="3" />
  </packageSources>
</configuration>
